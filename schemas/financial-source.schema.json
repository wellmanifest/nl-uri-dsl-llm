{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/financial-source.schema.json",
  "title": "Financial Source Manifest Schema",
  "description": "Standard schema for wellmanifest.faktury.source/v1 channel manifests conforming to nl-uri-dsl-llm NUL-010..013",
  "type": "object",
  "required": ["SCHEMA", "SOURCE_ID", "SOURCE_CHANNEL_TYPE", "CATEGORY", "NAME", "MONTH", "BASE_CURRENCY"],
  "properties": {
    "SCHEMA": {
      "type": "string",
      "const": "wellmanifest.faktury.source/v1"
    },
    "SOURCE_ID": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "SOURCE_CHANNEL_TYPE": {
      "type": "string",
      "enum": [
        "BANK_ACCOUNT_TRADITIONAL",
        "WALLET_PAYPAL",
        "GATEWAY_STRIPE",
        "MULTICURRENCY_REVOLUT",
        "PAYMENT_GATEWAY_AGGREGATOR",
        "CORPORATE_CARD",
        "MARKETPLACE_ALLEGRO",
        "GOV_KSEF_GATEWAY",
        "PORTAL_SAAS_VENDOR",
        "EMAIL_IMAP_STORE",
        "LOCAL_COST_STORE",
        "LOCAL_REVENUE_STORE"
      ]
    },
    "CATEGORY": {
      "type": "string",
      "enum": ["TRANSACTION_CHANNELS", "DOCUMENT_CHANNELS", "EMAIL_CHANNELS"]
    },
    "NAME": {
      "type": "string"
    },
    "MONTH": {
      "type": "string",
      "pattern": "^\\d{4}\\.(0[1-9]|1[0-2])$"
    },
    "BASE_CURRENCY": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "SUPPORTED_CURRENCIES": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
    },
    "DATA_FILES": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["FILE_NAME", "FILE_FORMAT"],
        "properties": {
          "FILE_NAME": { "type": "string" },
          "FILE_FORMAT": { "type": "string" },
          "TRANSACTIONS_COUNT": { "type": "integer" },
          "TOTAL_INFLOW": { "type": "number" },
          "TOTAL_OUTFLOW": { "type": "number" },
          "TOTAL_FEES": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "BALANCES": {
      "type": "object",
      "properties": {
        "OPENING_BALANCE": { "type": "number" },
        "CLOSING_BALANCE": { "type": "number" },
        "CURRENCY": { "type": "string" }
      },
      "additionalProperties": true
    },
    "INGESTION_STATUS": {
      "type": "string",
      "enum": ["STATUS_OK", "STATUS_PENDING", "STATUS_ERROR", "STATUS_REQUIRES_ATTENTION"]
    },
    "REQUIRES_MANUAL_ATTENTION": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
